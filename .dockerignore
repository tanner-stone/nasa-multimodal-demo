# Data files - large media files not needed in Docker image
setup/data/
data/
*.mp4
*.mp3
*.mov

# Git
.git
.gitignore

# Environment files (secrets should be injected at runtime)
.env
.env.*

# Node modules (will be installed fresh in build)
node_modules/

# Python cache
__pycache__/
*.py[cod]
*.pyo
.Python
env/
venv/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Logs
*.log
logs/

# Testing
.coverage
htmlcov/
.pytest_cache/

# macOS
.DS_Store

# NOTE: Do NOT exclude dist/, src/, public/, or build/ 
# These are needed for the multi-stage Docker build
